# Template for /var/www/talanta-docker/.env on the production server (never commit the real file).
# DB_HOST is set by compose.prod.yaml to the Docker network gateway, which reaches the host MySQL.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=talanta.conturetz.com,www.talanta.conturetz.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://talanta.conturetz.com,https://www.talanta.conturetz.com
CSRF_TRUSTED_ORIGINS=https://talanta.conturetz.com,https://www.talanta.conturetz.com
DJANGO_SECURE_COOKIES=True
FRONTEND_URL=https://talanta.conturetz.com

DB_ENGINE=django.db.backends.mysql
DB_NAME=talents
DB_USER=kabandwa
DB_PASSWORD=replace-with-the-database-password
DB_PORT=3306

# Gmail app password used for password-reset emails.
EMAIL_HOST_PASSWORD=
