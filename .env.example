# Copy to .env. Replace the example secret values before running Docker.
# For a public domain, update ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
MYSQL_ROOT_PASSWORD=replace-with-a-strong-unique-password

# Local development defaults:
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=5173
